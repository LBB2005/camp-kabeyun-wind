# Slack bot token — create app at api.slack.com/apps
# Required scopes: chat:write, reactions:read
SLACK_BOT_TOKEN=xoxb-...

# Channel ID of #camp-weather (right-click channel in Slack → View channel details → ID at bottom)
SLACK_CHANNEL_ID=C0XXXXXXXXX

# Tomorrow.io — console.tomorrow.io (free tier: 500 calls/day)
TOMORROW_IO_API_KEY=

# OpenWeatherMap — openweathermap.org/api (free tier: 1000 calls/day)
OPENWEATHERMAP_API_KEY=

# Anthropic API — console.anthropic.com
ANTHROPIC_API_KEY=
